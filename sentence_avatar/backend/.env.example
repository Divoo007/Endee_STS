# Copy this file to `.env` and fill in values. `.env` is loaded automatically
# on startup (python-dotenv). Everything here has a sane default except the
# OpenAI API key, which you must provide before the gloss endpoints will work.

# --- OpenAI (required for glossing) ---------------------------------------
# Your OpenAI API key. NOT set by default; the /api/gloss-* endpoints return
# HTTP 503 with a clear message until this is present.
OPENAI_API_KEY=

# Chat model used for English -> ISL glossing. Any current chat model works;
# json_schema structured output is used when the model supports it.
OPENAI_MODEL=gpt-4o

# Sampling temperature for the gloss call (low = more deterministic).
OPENAI_TEMPERATURE=0.2

# --- Transcription ---------------------------------------------------------
# Which speech-to-text backend to use: "local" (faster-whisper, default) or
# "openai" (OpenAI hosted transcription API, reuses OPENAI_API_KEY).
TRANSCRIBER=local

# Local faster-whisper model size: tiny | base | small | medium | large-v3
# Larger = more accurate + slower + more memory. "medium" (~1.5 GB, downloaded
# once) is the default: "base" frequently mis-hears the small closed vocabulary.
WHISPER_MODEL=medium

# Force decoding language (ISO-639-1). We expect English, so pinning "en" avoids
# short clips being mis-detected as another language. Leave blank to auto-detect.
WHISPER_LANGUAGE=en

# faster-whisper device: auto | cpu | cuda
WHISPER_DEVICE=auto

# faster-whisper compute type: int8 (fast CPU) | int8_float16 | float16 (GPU) |
# float32 | default
WHISPER_COMPUTE_TYPE=int8

# Model name when TRANSCRIBER=openai.
OPENAI_WHISPER_MODEL=whisper-1

# --- Paths -----------------------------------------------------------------
# Directory containing sign_words.py (the vocabulary source of truth).
# Defaults to the parent of this backend/ directory (../), i.e. sentence_avatar/.
# SENTENCE_AVATAR_DIR=/absolute/path/to/sentence_avatar

# Built Godot web app to serve at "/". Defaults to ../web_build.
# WEB_BUILD_DIR=/absolute/path/to/sentence_avatar/web_build

# --- Misc ------------------------------------------------------------------
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
